[provider]
# "openai" | "anthropic" | "custom" (any OpenAI-compatible server)
type = "custom"
# Expanded from the environment at load time; use any stub value for local vLLM/Ollama.
api_key = "${MIMA_API_KEY}"
# Point at the AGX Thor on the LAN (vLLM default port 8000), or a local Ollama, or a cloud API.
# mima appends /chat/completions, so give the API root only, without query strings.
# Azure OpenAI: "https://<resource>.openai.azure.com/openai/v1", with default_model
# set to the deployment name (see docs/cloud-providers.md).
base_url = "http://thor.local:8000/v1"
default_model = "nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-NVFP4"

[agent]
# A number, or "server" to send none (OpenAI reasoning models accept only their default).
temperature = 0.2
# Reply limit per request (reasoning counts against it). The context budget
# reserves at most half the window for it, and each request caps it at the
# room left. Cloud models have their own maximums (gpt-4o-mini: 16384); set
# it at or below the model's limit there.
max_tokens = 131072
# Request field for max_tokens: "max_tokens" (vLLM, Ollama) or "max_completion_tokens"
# (newer OpenAI and Azure OpenAI models, which reject "max_tokens").
# max_tokens_param = "max_tokens"
# "native" | "react" | "auto" (probe native, fall back to ReAct)
tool_calling = "auto"
stream = true
# Full-replacement system prompt; when non-empty it bypasses composition.
system_prompt_override = ""
# Composable system prompt. Omit a key to use the built-in default; set to ""
# to suppress that segment. Env overrides: MIMA_SYSTEM_PROMPT_PREFIX / _BODY /
# _SUFFIX, or MIMA_SYSTEM_PROMPT for a full replacement.
# system_prompt_prefix = ""
# system_prompt_body = ""
# system_prompt_suffix = ""
# Loop guards (see docs/design/design-loop-guards.md). Defaults shown.
# dedupe_identical_writes = true      # skip identical, already-successful writes
# loop_guard_window = 6               # sliding window for repeat detection
# loop_guard_repeat_threshold = 3     # repeats within the window that intervene
# max_steps = 50                      # hard cap on tool/reasoning steps per task

[security]
require_approval_for_bash = true
require_approval_for_writes = true
# Shell commands that skip the approval prompt. Each entry is a whole-word
# prefix: "cargo test" also allows "cargo test --release". Any command with
# shell operators (; & | ` $ ( ) < > \ or a newline) always prompts. Keep
# entries specific: "git" alone would allow "git push --force".
# auto_approve_bash = ["cargo test", "cargo build", "git status", "git diff"]
# bash_timeout_secs = 300             # kill a shell command after this long
# Sandbox for the filesystem tools ONLY. Does NOT constrain shell commands.
allowed_paths = ["./"]

# Context-window management (see docs/context.md). Defaults shown.
[context]
# window = 32768      # tokens; default: discovered from the server (vLLM max_model_len)
# budget = 96000      # operate below the window (tokens); default: whole usable window
# mask_at = 0.6       # compact above this fraction of the operating budget ...
# mask_to = 0.4       # ... down to this fraction (hide old tool output, then drop old steps)
# keep_recent = 0.25  # newest tool output protected from compaction (fraction of budget)
# keep_requests = 0.15  # earlier operator requests kept when steps are evicted (fraction of budget, max 20k tokens)
# server_tokenize = true  # count each request exactly via the server's /tokenize (vLLM)

# Sessions and transcripts (see docs/sessions.md). Transcripts are off by
# default; enable per run with --transcript or in the REPL with /enable_transcript.
[session]
# transcripts = false
# transcript_dir = "~/.mima/transcripts"
# max_output_bytes = 1048576  # per tool output stored in a transcript

# Project instructions (see docs/design/design-project-instructions.md):
# AGENTS.md files from the repository root down to the working directory,
# plus your own global file, added to the system prompt as labeled guidance.
# A workspace ./agent.toml may only turn this off or lower max_bytes.
[instructions]
# enabled = true                                  # or --no-project-instructions
# files = ["AGENTS.md"]                           # per directory, first match wins
#                                                 # (e.g. ["AGENTS.md", "CLAUDE.md"])
# global = "~/.config/minister_mandati/AGENTS.md" # "" for none
# max_bytes = 8192                                # total loaded, after cleaning

# Audit record (see docs/design/design-audit-record.md).
#
# Every recorded transcript is hash-chained: each record carries a hash of
# itself and the record before it, and the last record's hash (the head) is
# printed when the session ends.
#
# The session ledger is a separate file with one line per session start,
# recording on/off change and session end: time, user, host, working
# directory, whether recording was on, and at the end the record count and
# head. It is written even when transcripts are off, so unrecorded sessions
# are visible too. It holds no instructions, outputs or code. Check a
# transcript against it with `mima --audit-verify <id|last|path>`.
#
# A workspace ./agent.toml cannot change this table (it can only turn
# required mode on): mima takes [audit] from your own config file
# (~/.config/minister_mandati/agent.toml) or defaults.
[audit]
# ledger = "~/.mima/ledger.jsonl"   # where the session ledger (and each head) is kept
# record_host = true                # host name in the ledger and session header
# required = false                  # true: recording always on; a record is on disk
#                                   # before its action; a write failure stops mima.
#                                   # Per run: --audit or MIMA_AUDIT=1. Refuses to
#                                   # start if a sandbox path covers the transcript
#                                   # or ledger directory.
#
# Example: keep the ledger apart from the transcripts, where the account that
# runs mima can append but not rewrite it (for example another mount or a
# directory owned by an audit account), so a rewritten transcript no longer
# matches its recorded head:
# ledger = "/srv/audit/mima/ledger.jsonl"
#
# Example: regulated use:
# required = true
